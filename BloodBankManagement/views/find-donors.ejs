<%- include('partials/header', { title: 'Find Donors | LifeLine' }) %>
<section class="wrap find-donors-heading"><div><span class="eyebrow">COMMUNITY DONOR NETWORK</span><h1>Find a donor</h1><p>Browse available donors, or narrow your search by blood group, city, age, or gender.</p></div><img src="/images/community-donation.jpg" alt="Person donating blood with support from a healthcare professional" loading="lazy" decoding="async"></section>
<section class="wrap donor-search-panel"><div class="donor-search-icon"><%- include('partials/visual', { kind: 'donors' }) %></div><form class="search-form donor-search-form" method="get" action="/donors#search-results" data-loading-text="Searching donors..."><label>Blood group<select name="bloodGroup"><option value="">Any blood group</option><% bloodGroups.forEach((group) => { %><option value="<%= group %>" <%= selectedGroup === group ? 'selected' : '' %>><%= group %></option><% }) %></select></label><label>Location<input name="city" value="<%= city %>" maxlength="100" placeholder="Enter your location"></label><label>Minimum age<input name="minAge" type="number" min="18" max="65" value="<%= minAge %>" placeholder="18"></label><label>Maximum age<input name="maxAge" type="number" min="18" max="65" value="<%= maxAge %>" placeholder="65"></label><label>Gender<select name="gender"><option value="">Any gender</option><% ['Female', 'Male', 'Other', 'Prefer not to say'].forEach((value) => { %><option value="<%= value %>" <%= gender === value ? 'selected' : '' %>><%= value %></option><% }) %></select></label><div class="donor-search-actions"><button class="button button-primary" type="submit" aria-live="polite"><span data-loading-label>Search donors</span> <span aria-hidden="true">⌕</span></button><a class="donor-clear-link" href="/donors#search-results">Clear filters</a></div></form></section>
<section class="wrap results-section" id="search-results" tabindex="-1">
  <% if (searchActive) { %><div class="results-heading"><div><span class="eyebrow">SEARCH RESULTS</span><h2>Available donors <span class="result-count"><%= donors.length %></span></h2></div><% if (selectedGroup) { %><span class="blood-type"><%= selectedGroup %></span><% } %></div>
    <% if (donors.length) { %><p class="donor-results-hint">Showing <%= donors.length %> available donor<%= donors.length === 1 ? '' : 's' %>. Photos appear only when donors have uploaded one and consented to display it.</p><div class="donor-grid"><% donors.forEach((donor, index) => { const name = donor.fullName || donor.user?.fullName || 'LifeLine donor'; const phone = donor.phone || donor.user?.phone || ''; const initials = name.split(' ').map((part) => part[0]).slice(0,2).join('').toUpperCase(); const hasPhoto = Boolean(donor.photoPath && donor.photoConsent); %><article class="donor-card donor-profile-card"><div class="donor-profile-banner donor-profile-banner-<%= index % 4 %>"><span>AVAILABLE DONOR</span><span class="donor-profile-blood" aria-label="Blood group <%= donor.bloodGroup %>"><%= donor.bloodGroup %></span></div><div class="donor-card-top"><div class="donor-avatar donor-avatar-<%= index % 4 %>" role="img" aria-label="<%= hasPhoto ? `Profile photo of ${name}` : `Profile initials for ${name}` %>"><span class="donor-avatar-initials" aria-hidden="<%= hasPhoto ? 'true' : 'false' %>"><%= initials %></span><% if (hasPhoto) { %><img src="<%= donor.photoPath %>" alt="" loading="lazy" decoding="async"><% } %></div><div class="donor-card-person"><h3><%= name %></h3><p><span class="donor-location">⌖ <%= donor.city %></span></p></div></div><div class="donor-card-foot"><span class="available-pill"><i></i> Available</span><a class="phone-link" href="tel:<%= phone %>">Contact donor <span aria-hidden="true">→</span></a></div><p class="card-note"><%= hasPhoto ? 'Donor photo shared with permission.' : 'No profile photo provided. Confirm availability directly with the donor.' %></p></article><% }) %></div>
    <% } else { %><div class="empty-state donor-empty" role="status" aria-live="polite"><span class="empty-drop" aria-hidden="true">♥</span><h3>No donors found</h3><p>No available donors match your search right now. Try another blood group or location, or clear the filters.</p><div class="empty-actions"><a class="button button-outline" href="/donors#search-results">Clear filters</a><a class="button button-primary" href="/donor/register">Register as a donor</a><a class="text-link" href="/emergency-match">Try emergency match →</a></div></div><% } %>
  <% } else { %><div class="empty-state donor-empty"><span class="empty-drop">♥</span><h3>Search your local donor network</h3><p>Choose any combination of blood group, location, age and gender to find available donors in your community.</p></div><% } %>
</section>
<%- include('partials/footer') %>
