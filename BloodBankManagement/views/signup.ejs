<%- include('partials/header', { title: 'Sign up | LifeLine' }) %>
<section class="auth-layout signup-page"><div class="auth-card"><div class="auth-illustration"><img src="/images/signup-donation-portrait.jpg" alt="A seated donor receiving care from a healthcare professional during a blood draw" loading="lazy" decoding="async"><span>GIVE. CONNECT. CARE.</span></div><div class="auth-card-inner"><span class="eyebrow">JOIN THE COMMUNITY</span><h1>Create your account</h1><p>Join LifeLine today and help bring people together.</p>
  <form method="post" action="/signup" class="form-stack"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><label>Full name<input name="fullName" maxlength="100" autocomplete="name" required placeholder="Your full name"></label><label>Email<input type="email" name="email" maxlength="120" autocomplete="email" required placeholder="you@example.com"></label><label>Phone number<input name="phone" maxlength="20" autocomplete="tel" required placeholder="Contact number"></label><label>Password <small>(8+ characters)</small><input type="password" name="password" minlength="8" maxlength="128" autocomplete="new-password" required placeholder="Create a strong password"></label><label>Confirm password<input type="password" name="confirmPassword" minlength="8" maxlength="128" autocomplete="new-password" required placeholder="Enter your password again"></label><button class="button button-primary button-large">Sign up</button></form>
  <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p></div>
</div></section>
<%- include('partials/footer') %>
